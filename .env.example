# Copy to backend/.env and frontend/.env.local as needed.
# Never commit real secrets.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=Anvil

# --- Database (existing remote PostgreSQL — do not run a local Postgres container) ---
DATABASE_HOST=100.95.177.124
DATABASE_PORT=5432
DATABASE_NAME=interview_anvil
DATABASE_USER=postgres
DATABASE_PASSWORD=example
# Optional override. If unset, the backend composes this from the fields above.
# DATABASE_URL=postgresql+psycopg://postgres:example@100.95.177.124:5432/interview_anvil

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
COOKIE_NAME=ia_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS (used when the browser talks to the API directly) ---
CORS_ORIGINS=http://localhost:3000

# --- Code execution ---
# Local: FastAPI shells out to `docker run` using this image.
CODE_RUNNER_IMAGE=interview-anvil-java-runner:local
# Optional remote runner. When set, FastAPI POSTs jobs here instead of using Docker locally.
CODE_RUNNER_URL=
CODE_RUNNER_TIMEOUT_SECONDS=20
CODE_RUNNER_MEMORY_MB=256
CODE_RUNNER_CPUS=1
# Leave empty for host-run FastAPI. In Docker, set to a bind-mounted host path.
CODE_RUNNER_JOB_DIR=
CODE_RUNNER_HOST_JOB_DIR=

# --- Mock interviews (Ollama) ---
OLLAMA_BASE_URL=http://100.120.169.81:11434
OLLAMA_MODEL=gemma3:4b
INTERVIEW_LLM_PROVIDER=ollama
# INTERVIEW_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# INTERVIEW_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.5-flash
# INTERVIEW_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
INTERVIEW_DURATION_SECONDS=2700
TTS_BASE_URL=http://100.120.169.81:8091
TTS_VOICE=af_heart
TTS_LANGUAGE=English

# --- Frontend (frontend/.env.local) ---
# Browser calls Next.js; Next.js proxies /api/* to the backend.
NEXT_PUBLIC_API_BASE=
API_PROXY_TARGET=http://localhost:8000
# Public origin used for sitemap, canonical URLs, and Open Graph.
# Production example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Optional Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=
