{
  "slug": "twitter-feed",
  "name": "Twitter",
  "summary": "Users → DNS → LB → Timeline API. Redis holds the home timeline, NoSQL stores tweets, Postgres the follow graph, Kafka → fan-out workers write timelines and feed tweet search.",
  "difficulty": "advanced",
  "workload": {
    "dau": 100000000,
    "concurrent_users": 400000,
    "requests_per_user_day": 25,
    "read_ratio": 0.96,
    "avg_request_bytes": 800,
    "avg_response_bytes": 4000,
    "peak_multiplier": 5,
    "traffic_growth": 0.2,
    "avg_record_bytes": 500
  },
  "slo": {
    "availability": 0.9999,
    "p95_ms": 200,
    "p99_ms": 500,
    "error_rate": 0.001,
    "rpo_seconds": 30,
    "rto_seconds": 180
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Users",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 3,
        "qps": 400000
      }
    },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Load Balancer",
      "x": 500,
      "y": 230,
      "config": {
        "instances": 8,
        "maxRps": 200000,
        "algorithm": "least_connections"
      }
    },
    {
      "id": "api",
      "type": "api_server",
      "label": "Timeline API",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 160,
        "vcpu": 8,
        "avgLatencyMs": 6,
        "p95LatencyMs": 18,
        "autoscaling": true,
        "minInstances": 80,
        "maxInstances": 240
      }
    },
    {
      "id": "ids",
      "type": "id_generator",
      "label": "Tweet IDs",
      "x": 960,
      "y": 80,
      "config": {
        "instances": 4,
        "scheme": "snowflake"
      }
    },
    {
      "id": "timeline",
      "type": "redis",
      "label": "Home Timeline",
      "x": 960,
      "y": 230,
      "config": {
        "memoryGb": 256,
        "hitRatio": 0.94,
        "maxOps": 300000,
        "replicas": 2
      }
    },
    {
      "id": "tweets",
      "type": "nosql",
      "label": "Tweet Store",
      "x": 960,
      "y": 380,
      "config": {
        "vcpu": 16,
        "storageGb": 40000,
        "readCapacity": 80000,
        "writeCapacity": 25000,
        "replicationFactor": 3,
        "iops": 60000
      }
    },
    {
      "id": "graph",
      "type": "postgresql",
      "label": "Follow Graph",
      "x": 960,
      "y": 530,
      "config": {
        "vcpu": 12,
        "storageGb": 4000,
        "readCapacity": 40000,
        "writeCapacity": 8000,
        "readReplicas": 3,
        "iops": 30000
      }
    },
    {
      "id": "search",
      "type": "search_index",
      "label": "Tweet Search",
      "x": 1190,
      "y": 80,
      "config": {
        "nodes": 8,
        "replicas": 1,
        "shards": 16,
        "queryCapacity": 5000,
        "indexLagSec": 3,
        "documents": 5000000000,
        "docBytes": 400
      }
    },
    {
      "id": "fanout",
      "type": "kafka",
      "label": "Fan-out",
      "x": 960,
      "y": 680,
      "config": {
        "brokers": 9,
        "partitions": 72,
        "consumers": 24,
        "producerThroughput": 80000,
        "consumerThroughput": 70000
      }
    },
    {
      "id": "workers",
      "type": "worker",
      "label": "Fan-out Workers",
      "x": 1190,
      "y": 680,
      "config": {
        "instances": 80,
        "concurrency": 16,
        "jobMs": 40,
        "idempotent": true
      }
    },
    {
      "id": "push",
      "type": "notification_gateway",
      "label": "Push",
      "x": 1420,
      "y": 680,
      "config": {
        "providerRateLimit": 800,
        "batchSize": 100,
        "channel": "push"
      }
    }
  ],
  "edges": [
