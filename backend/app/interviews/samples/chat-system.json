{
  "slug": "chat-system",
  "name": "Chat System",
  "summary": "Mobile clients hold sockets on a WebSocket gateway. The chat API writes to NoSQL, IDs come from a generator, presence lives in Redis, Kafka → delivery workers push to offline users and index history for search.",
  "difficulty": "advanced",
  "workload": {
    "dau": 40000000,
    "concurrent_users": 150000,
    "requests_per_user_day": 50,
    "read_ratio": 0.7,
    "avg_request_bytes": 400,
    "avg_response_bytes": 800,
    "peak_multiplier": 3,
    "traffic_growth": 0.2,
    "avg_record_bytes": 300
  },
  "slo": {
    "availability": 0.999,
    "p95_ms": 150,
    "p99_ms": 400,
    "error_rate": 0.002,
    "rpo_seconds": 10,
    "rto_seconds": 120
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Mobile Clients",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 3,
        "qps": 200000
      }
    },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Gateway LB",
      "x": 500,
      "y": 230,
      "config": {
        "instances": 6,
        "maxRps": 120000,
        "algorithm": "least_connections"
      }
    },
    {
      "id": "ws",
      "type": "websocket_gateway",
      "label": "WebSocket Gateway",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 12,
        "maxConnections": 20000,
        "messagesPerSec": 20000,
        "heartbeatSec": 30,
        "fanout": 1
      }
    },
    {
      "id": "gateway",
      "type": "api_server",
      "label": "Chat API",
      "x": 960,
      "y": 230,
      "config": {
        "instances": 80,
        "vcpu": 8,
        "avgLatencyMs": 6,
        "p95LatencyMs": 16,
        "autoscaling": true,
        "minInstances": 40,
        "maxInstances": 160
      }
    },
    {
      "id": "ids",
      "type": "id_generator",
      "label": "Message IDs",
      "x": 1190,
      "y": 80,
      "config": {
        "instances": 3,
        "idsPerSec": 100000,
        "scheme": "snowflake"
      }
    },
    {
      "id": "presence",
      "type": "redis",
      "label": "Presence",
      "x": 1190,
      "y": 230,
      "config": {
        "memoryGb": 64,
        "hitRatio": 0.98,
        "maxOps": 200000,
        "ttlSec": 30,
        "replicas": 2
      }
    },
    {
      "id": "messages",
      "type": "nosql",
      "label": "Message Log",
      "x": 1190,
      "y": 380,
      "config": {
        "vcpu": 16,
        "storageGb": 80000,
        "readCapacity": 60000,
        "writeCapacity": 40000,
        "replicationFactor": 3,
        "iops": 80000
      }
    },
    {
      "id": "delivery",
      "type": "kafka",
      "label": "Delivery",
      "x": 1190,
      "y": 530,
      "config": {
        "brokers": 6,
        "partitions": 48,
        "consumers": 16,
        "producerThroughput": 80000,
        "consumerThroughput": 70000
      }
    },
    {
      "id": "workers",
      "type": "worker",
      "label": "Delivery Workers",
      "x": 1420,
      "y": 530,
      "config": {
        "instances": 40,
        "concurrency": 16,
        "jobMs": 20,
        "idempotent": true
      }
    },
    {
      "id": "push",
      "type": "notification_gateway",
      "label": "Push (APNs / FCM)",
      "x": 1650,
      "y": 380,
      "config": {
        "providerRateLimit": 600,
        "batchSize": 100,
        "channel": "push"
      }
    },
    {
      "id": "search",
      "type": "search_index",
      "label": "Message Search",
      "x": 1650,
      "y": 530,
      "config": {
        "nodes": 2,
        "replicas": 1,
        "shards": 4,
        "queryCapacity": 5000,
        "indexLagSec": 5,
        "documents": 2000000000,
        "docBytes": 300
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-dns",
      "source": "users",
      "target": "dns"
    },
    {
      "id": "e-dns-lb",
      "source": "dns",
      "target": "lb"
    },
    {
      "id": "e-lb-ws",
      "source": "lb",
      "target": "ws"
    },
    {
      "id": "e-ws-gateway",
      "source": "ws",
      "target": "gateway"
    },
    {
      "id": "e-gateway-ids",
      "source": "gateway",
      "target": "ids"
    },
    {
      "id": "e-gateway-presence",
      "source": "gateway",
      "target": "presence"
    },
    {
      "id": "e-gateway-messages",
      "source": "gateway",
      "target": "messages"
    },
    {
      "id": "e-gateway-delivery",
      "source": "gateway",
      "target": "delivery"
    },
    {
      "id": "e-gateway-search",
      "source": "gateway",
      "target": "search",
      "label": "history search",
      "weight": 0.02
    },
    {
      "id": "e-delivery-workers",
      "source": "delivery",
      "target": "workers"
    },
    {
      "id": "e-workers-push",
      "source": "workers",
      "target": "push",
      "label": "offline users",
      "weight": 0.3
    },
    {
      "id": "e-workers-search",
      "source": "workers",
      "target": "search",
      "label": "index",
      "weight": 1.0
    }
  ]
}
