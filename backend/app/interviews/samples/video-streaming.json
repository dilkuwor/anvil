{
  "slug": "video-streaming",
  "name": "YouTube",
  "summary": "Viewers → DNS → CDN for playback; CDN misses read straight from object storage. The catalog API serves metadata and search; uploads go to Kafka → transcode workers that write renditions back.",
  "difficulty": "advanced",
  "workload": {
    "dau": 50000000,
    "concurrent_users": 80000,
    "requests_per_user_day": 6,
    "read_ratio": 0.97,
    "avg_request_bytes": 800,
    "avg_response_bytes": 80000,
    "peak_multiplier": 4,
    "traffic_growth": 0.25,
    "avg_record_bytes": 5000
  },
  "slo": {
    "availability": 0.999,
    "p95_ms": 400,
    "p99_ms": 900,
    "error_rate": 0.002,
    "rpo_seconds": 60,
    "rto_seconds": 300
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Viewers",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 3,
        "qps": 200000
      }
    },
    {
      "id": "cdn",
      "type": "cdn",
      "label": "Video CDN",
      "x": 500,
      "y": 230,
      "config": {
        "hitRatio": 0.92,
        "maxRps": 200000,
        "edgeLatencyMs": 18,
        "ttlSec": 600
      }
    },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Origin LB",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 4,
        "maxRps": 40000,
        "algorithm": "least_connections"
      }
    },
    {
      "id": "api",
      "type": "api_server",
      "label": "Catalog API",
      "x": 960,
      "y": 230,
      "config": {
        "instances": 40,
        "vcpu": 4,
        "avgLatencyMs": 8,
        "p95LatencyMs": 22,
        "autoscaling": true,
        "minInstances": 16,
        "maxInstances": 80
      }
    },
    {
      "id": "catalog",
      "type": "postgresql",
      "label": "Metadata",
      "x": 1190,
      "y": 230,
      "config": {
        "vcpu": 8,
        "storageGb": 2000,
        "readCapacity": 25000,
        "writeCapacity": 4000,
        "readReplicas": 1
      }
    },
    {
      "id": "search",
      "type": "search_index",
      "label": "Catalog Search",
      "x": 1190,
      "y": 80,
      "config": {
        "nodes": 3,
        "replicas": 1,
        "shards": 6,
        "queryCapacity": 5000,
        "documents": 50000000,
        "docBytes": 800
      }
    },
    {
      "id": "videos",
      "type": "object_storage",
      "label": "Video Store",
      "x": 730,
      "y": 530,
      "config": {
        "capacityTb": 400,
        "avgObjectKb": 8192,
        "readRps": 40000,
        "writeRps": 4000
      }
    },
    {
      "id": "transcode",
      "type": "kafka",
      "label": "Transcode Jobs",
      "x": 1190,
      "y": 380,
      "config": {
        "brokers": 6,
        "partitions": 36,
        "consumers": 20,
        "producerThroughput": 20000,
        "consumerThroughput": 15000
      }
    },
    {
      "id": "transcoders",
      "type": "worker",
      "label": "Transcode Workers",
      "x": 1420,
      "y": 380,
      "config": {
        "instances": 40,
        "concurrency": 8,
        "jobMs": 5000,
        "idempotent": true
      }
    },
    {
      "id": "views",
      "type": "analytics_store",
      "label": "View Events",
      "x": 1420,
      "y": 80,
      "config": {
        "nodes": 3,
        "retentionDays": 90,
        "eventBytes": 200,
        "eventsPerDay": 300000000
      }
    }
  ],
