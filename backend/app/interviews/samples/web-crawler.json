{
  "slug": "web-crawler",
  "name": "Web Crawler",
  "summary": "Ops/seeds → DNS → LB → Crawler API. Redis dedups URLs, Kafka is the frontier, object storage holds pages, Postgres tracks crawl metadata.",
  "difficulty": "intermediate",
  "workload": {
    "dau": 1000000,
    "concurrent_users": 8000,
    "requests_per_user_day": 80,
    "read_ratio": 0.25,
    "avg_request_bytes": 2000,
    "avg_response_bytes": 40000,
    "peak_multiplier": 2,
    "traffic_growth": 0.15
  },
  "slo": {
    "availability": 0.99,
    "p95_ms": 800,
    "p99_ms": 2000,
    "error_rate": 0.01,
    "rpo_seconds": 300,
    "rto_seconds": 600
  },
  "nodes": [
    { "id": "users", "type": "client", "label": "Seeds / Workers", "x": 40, "y": 240 },
    { "id": "dns", "type": "dns", "label": "DNS", "x": 250, "y": 240, "config": { "latencyMs": 5, "qps": 50000 } },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Load Balancer",
      "x": 480, "y": 240,
      "config": { "instances": 3, "maxRps": 10000, "algorithm": "round_robin" }
    },
    {
      "id": "crawler",
      "type": "api_server",
      "label": "Crawler Workers",
      "x": 720, "y": 240,
      "config": {
        "instances": 16,
        "vcpu": 4,
        "avgLatencyMs": 15,
        "p95LatencyMs": 40,
        "autoscaling": true,
        "minInstances": 8,
        "maxInstances": 48
      }
    },
    {
      "id": "seen",
      "type": "redis",
      "label": "Seen URLs",
      "x": 1000, "y": 60,
      "config": { "memoryGb": 64, "hitRatio": 0.85, "maxOps": 60000, "ttlSec": 86400, "replicas": 1 }
    },
    {
      "id": "frontier",
      "type": "kafka",
      "label": "URL Frontier",
      "x": 1000, "y": 200,
      "config": { "brokers": 5, "partitions": 48, "consumers": 16, "producerThroughput": 30000, "consumerThroughput": 25000 }
    },
    {
      "id": "pages",
      "type": "object_storage",
      "label": "Page Store",
      "x": 1000, "y": 340,
      "config": { "capacityTb": 80, "avgObjectKb": 128, "readRps": 8000, "writeRps": 6000 }
    },
    {
      "id": "meta",
      "type": "postgresql",
      "label": "Crawl Meta",
      "x": 1000, "y": 480,
      "config": { "vcpu": 8, "storageGb": 2000, "readCapacity": 8000, "writeCapacity": 6000, "readReplicas": 1 }
    }
  ],
  "edges": [
    { "id": "e-users-dns", "source": "users", "target": "dns" },
    { "id": "e-dns-lb", "source": "dns", "target": "lb" },
    { "id": "e-lb-crawler", "source": "lb", "target": "crawler" },
    { "id": "e-crawler-seen", "source": "crawler", "target": "seen" },
    { "id": "e-crawler-frontier", "source": "crawler", "target": "frontier" },
    { "id": "e-crawler-pages", "source": "crawler", "target": "pages" },
    { "id": "e-crawler-meta", "source": "crawler", "target": "meta" }
  ]
}
