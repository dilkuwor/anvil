{
  "slug": "web-crawler",
  "name": "Web Crawler",
  "summary": "Operators seed URLs through the crawl API; a recrawl scheduler tops up the Kafka frontier. Fetch workers dedup against Redis, store pages in object storage, update crawl metadata, and index pages for search.",
  "difficulty": "intermediate",
  "workload": {
    "dau": 1000000,
    "concurrent_users": 8000,
    "requests_per_user_day": 80,
    "read_ratio": 0.25,
    "avg_request_bytes": 2000,
    "avg_response_bytes": 2000,
    "peak_multiplier": 2,
    "traffic_growth": 0.15,
    "avg_record_bytes": 2000
  },
  "slo": {
    "availability": 0.99,
    "p95_ms": 800,
    "p99_ms": 2000,
    "error_rate": 0.01,
    "rpo_seconds": 300,
    "rto_seconds": 600
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Operators / Seed API",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 5,
        "qps": 50000
      }
    },
    {
      "id": "lb",
