      "label": "Crawl API",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 12,
        "vcpu": 4,
        "avgLatencyMs": 15,
        "p95LatencyMs": 40,
        "autoscaling": true,
        "minInstances": 6,
        "maxInstances": 24
      }
    },
    {
      "id": "cron",
      "type": "scheduler",
      "label": "Recrawl Scheduler",
      "x": 730,
      "y": 380,
      "config": {
        "instances": 2,
        "jobsPerSec": 2000,
        "leaderElection": true,
        "bytesPerJob": 200
      }
    },
    {
