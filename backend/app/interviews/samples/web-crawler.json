      "x": 1420,
      "y": 530,
      "config": {
        "nodes": 6,
        "replicas": 1,
        "shards": 12,
        "queryCapacity": 3000,
        "indexLagSec": 60,
        "documents": 1000000000,
        "docBytes": 2000
      }
    }
