      "label": "Seen URLs",
      "x": 1420,
      "y": 80,
      "config": {
        "memoryGb": 64,
        "hitRatio": 0.85,
        "maxOps": 60000,
        "ttlSec": 86400,
        "replicas": 1
      }
    },
    {
      "id": "pages",
