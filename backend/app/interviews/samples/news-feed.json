      "target": "cdn"
    },
    {
      "id": "e-cdn-media",
      "source": "cdn",
      "target": "media",
      "label": "media misses",
      "weight": 0.4
    },
    {
      "id": "e-cdn-lb",
      "source": "cdn",
      "target": "lb"
    },
    {
      "id": "e-lb-api",
      "source": "lb",
      "target": "api"
    },
    {
      "id": "e-api-ids",
      "source": "api",
      "target": "ids"
    },
    {
      "id": "e-api-feed",
      "source": "api",
      "target": "feed"
    },
    {
      "id": "e-api-posts",
      "source": "api",
      "target": "posts"
    },
    {
      "id": "e-api-graph",
      "source": "api",
      "target": "graph",
      "label": "follows",
      "weight": 0.1
    },
    {
      "id": "e-api-media",
      "source": "api",
      "target": "media",
      "label": "uploads",
      "weight": 0.3
    },
    {
      "id": "e-api-publish",
      "source": "api",
      "target": "publish"
    },
    {
      "id": "e-publish-workers",
      "source": "publish",
      "target": "workers"
    },
    {
      "id": "e-workers-feed",
      "source": "workers",
      "target": "feed",
      "label": "timeline writes",
      "weight": 1.0
    },
    {
      "id": "e-workers-push",
      "source": "workers",
      "target": "push",
      "label": "mentions",
      "weight": 0.2
    }
  ]
}
