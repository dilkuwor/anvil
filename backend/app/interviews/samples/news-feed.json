{
  "slug": "news-feed",
  "name": "News Feed",
  "summary": "Users → DNS → CDN → LB → Feed API. Redis serves the precomputed home feed, NoSQL stores posts, Postgres the friend graph, Kafka → fan-out workers write timelines and push notifications.",
  "difficulty": "advanced",
  "workload": {
    "dau": 80000000,
    "concurrent_users": 300000,
    "requests_per_user_day": 30,
    "read_ratio": 0.95,
    "avg_request_bytes": 800,
    "avg_response_bytes": 8000,
    "peak_multiplier": 4,
    "traffic_growth": 0.2,
    "avg_record_bytes": 2000
  },
  "slo": {
    "availability": 0.999,
    "p95_ms": 200,
    "p99_ms": 500,
    "error_rate": 0.002,
    "rpo_seconds": 30,
    "rto_seconds": 180
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Users",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 3,
        "qps": 300000
      }
    },
    {
      "id": "cdn",
      "type": "cdn",
      "label": "Media CDN",
      "x": 500,
      "y": 230,
      "config": {
        "hitRatio": 0.7,
        "maxRps": 200000,
        "edgeLatencyMs": 20,
        "ttlSec": 180
      }
    },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Load Balancer",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 6,
        "maxRps": 150000,
        "algorithm": "least_connections"
      }
    },
    {
      "id": "api",
      "type": "api_server",
      "label": "Feed API",
      "x": 960,
      "y": 230,
      "config": {
        "instances": 120,
        "vcpu": 8,
        "avgLatencyMs": 6,
        "p95LatencyMs": 20,
        "autoscaling": true,
        "minInstances": 60,
        "maxInstances": 200
      }
    },
    {
      "id": "ids",
      "type": "id_generator",
      "label": "Post IDs",
      "x": 1190,
      "y": 80,
      "config": {
        "instances": 3,
        "scheme": "snowflake"
      }
    },
    {
      "id": "feed",
      "type": "redis",
      "label": "Feed Cache",
      "x": 1190,
      "y": 230,
      "config": {
        "memoryGb": 192,
        "hitRatio": 0.93,
        "maxOps": 250000,
        "replicas": 2
      }
    },
    {
      "id": "posts",
      "type": "nosql",
      "label": "Post Store",
      "x": 1190,
      "y": 380,
      "config": {
        "vcpu": 16,
        "storageGb": 100000,
        "readCapacity": 70000,
        "writeCapacity": 20000,
        "replicationFactor": 3,
        "iops": 60000
      }
    },
    {
      "id": "graph",
      "type": "postgresql",
      "label": "Friend Graph",
      "x": 1190,
      "y": 530,
      "config": {
        "vcpu": 12,
        "storageGb": 5000,
        "readCapacity": 35000,
        "writeCapacity": 6000,
        "readReplicas": 1,
        "iops": 30000
      }
    },
    {
      "id": "media",
      "type": "object_storage",
      "label": "Media Store",
      "x": 1420,
      "y": 80,
      "config": {
        "capacityTb": 800,
        "avgObjectKb": 1024,
        "readRps": 40000,
        "writeRps": 6000
      }
    },
    {
      "id": "publish",
      "type": "kafka",
      "label": "Publish",
      "x": 1190,
      "y": 680,
      "config": {
        "brokers": 8,
        "partitions": 64,
        "consumers": 20,
        "producerThroughput": 60000,
        "consumerThroughput": 50000
      }
    },
    {
      "id": "workers",
      "type": "worker",
      "label": "Fan-out Workers",
      "x": 1420,
      "y": 680,
      "config": {
        "instances": 20,
        "concurrency": 16,
        "jobMs": 40,
        "idempotent": true
      }
    },
    {
      "id": "push",
      "type": "notification_gateway",
      "label": "Push",
      "x": 1650,
      "y": 680,
      "config": {
        "providerRateLimit": 500,
        "batchSize": 100,
        "channel": "push"
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-dns",
      "source": "users",
      "target": "dns"
    },
    {
      "id": "e-dns-cdn",
