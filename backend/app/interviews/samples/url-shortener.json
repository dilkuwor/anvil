{
  "slug": "url-shortener",
  "name": "URL Shortener",
  "summary": "Users → DNS → rate limit → LB → API. IDs from a generator, Redis on the redirect path, Postgres for links, Kafka → analytics store for clicks.",
  "difficulty": "intermediate",
  "workload": {
    "dau": 20000000,
    "concurrent_users": 80000,
    "requests_per_user_day": 8,
    "read_ratio": 0.92,
    "avg_request_bytes": 400,
    "avg_response_bytes": 800,
    "peak_multiplier": 5,
    "traffic_growth": 0.25,
    "avg_record_bytes": 500
  },
  "slo": {
    "availability": 0.9999,
    "p95_ms": 200,
    "p99_ms": 400,
    "error_rate": 0.001,
    "rpo_seconds": 60,
    "rto_seconds": 300
  },
  "nodes": [
    {
      "id": "users",
      "type": "client",
      "label": "Users",
      "x": 40,
      "y": 230
    },
    {
      "id": "dns",
      "type": "dns",
      "label": "DNS",
      "x": 270,
      "y": 230,
      "config": {
        "latencyMs": 3,
        "qps": 200000
      }
    },
    {
      "id": "limiter",
      "type": "rate_limiter",
      "label": "Rate Limiter",
      "x": 500,
      "y": 230,
      "config": {
        "limitRps": 40000,
        "burst": 8000,
        "algorithm": "token_bucket"
      }
    },
    {
      "id": "lb",
      "type": "load_balancer",
      "label": "Load Balancer",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 3,
        "maxRps": 40000,
        "algorithm": "least_connections"
      }
    },
    {
      "id": "api",
      "type": "api_server",
      "label": "Redirect API",
      "x": 960,
      "y": 230,
      "config": {
        "instances": 16,
        "vcpu": 4,
        "avgLatencyMs": 12,
        "p95LatencyMs": 28,
        "autoscaling": true,
        "minInstances": 8,
        "maxInstances": 48
      }
    },
    {
      "id": "ids",
      "type": "id_generator",
      "label": "Short-code IDs",
      "x": 1190,
      "y": 80,
      "config": {
        "instances": 3,
        "idsPerSec": 50000,
        "scheme": "key_range"
      }
    },
    {
      "id": "cache",
      "type": "redis",
      "label": "Redirect Cache",
      "x": 1190,
      "y": 230,
      "config": {
        "memoryGb": 64,
        "hitRatio": 0.92,
        "maxOps": 200000,
        "replicas": 1
      }
    },
    {
      "id": "db",
      "type": "postgresql",
      "label": "Links DB",
      "x": 1190,
      "y": 380,
      "config": {
        "vcpu": 8,
        "storageGb": 6000,
        "readCapacity": 20000,
        "writeCapacity": 6000,
        "readReplicas": 2,
        "dailyGrowthGb": 12
      }
    },
    {
      "id": "analytics",
      "type": "kafka",
      "label": "Click Events",
      "x": 1190,
      "y": 530,
      "config": {
        "brokers": 3,
        "partitions": 18,
        "consumers": 8,
        "producerThroughput": 40000,
        "consumerThroughput": 30000
      }
    },
    {
      "id": "clicks",
      "type": "analytics_store",
      "label": "Click Analytics",
      "x": 1420,
      "y": 530,
      "config": {
        "nodes": 3,
        "retentionDays": 180,
        "eventBytes": 150,
        "eventsPerDay": 160000000
      }
    }
  ],
  "edges": [
    {
      "id": "e-users-dns",
      "source": "users",
      "target": "dns"
    },
    {
      "id": "e-dns-limiter",
      "source": "dns",
      "target": "limiter"
    },
    {
      "id": "e-limiter-lb",
      "source": "limiter",
      "target": "lb"
    },
    {
      "id": "e-lb-api",
      "source": "lb",
      "target": "api"
    },
    {
      "id": "e-api-ids",
      "source": "api",
      "target": "ids"
    },
    {
      "id": "e-api-cache",
      "source": "api",
      "target": "cache"
    },
    {
      "id": "e-api-db",
      "source": "api",
      "target": "db"
    },
    {
      "id": "e-api-analytics",
      "source": "api",
      "target": "analytics"
    },
    {
      "id": "e-analytics-clicks",
      "source": "analytics",
      "target": "clicks"
    }
  ]
}
