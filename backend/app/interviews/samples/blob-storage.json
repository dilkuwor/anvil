{
  "slug": "blob-storage",
  "name": "Blob Storage",
  "summary": "Clients → DNS → LB → front door API. Metadata lives in a sharded NoSQL store; bytes go to object storage data nodes in chunks; a CDN serves hot public objects; a scrubber worker checks checksums.",
  "difficulty": "intermediate",
  "workload": {
    "dau": 500000,
    "concurrent_users": 30000,
    "requests_per_user_day": 60,
    "read_ratio": 0.8,
    "avg_request_bytes": 500,
    "avg_response_bytes": 524288,
    "peak_multiplier": 3,
    "traffic_growth": 0.4,
    "avg_record_bytes": 300
  },
  "slo": {
    "availability": 0.9999,
    "p95_ms": 120,
    "p99_ms": 300,
    "error_rate": 0.0005,
    "rpo_seconds": 0,
    "rto_seconds": 120
  },
  "nodes": [
