      "x": 960,
      "y": 230,
      "config": {
        "capacityTb": 5000,
        "avgObjectKb": 512,
        "readRps": 40000,
        "writeRps": 8000
      }
    },
    {
      "id": "scrub",
      "type": "worker",
      "label": "Checksum Scrubber",
      "x": 960,
      "y": 380,
      "config": {
        "instances": 4,
        "concurrency": 4,
        "jobMs": 2000,
        "idempotent": true
      }
