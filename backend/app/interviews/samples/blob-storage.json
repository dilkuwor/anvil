      "label": "Front Door API",
      "x": 730,
      "y": 230,
      "config": {
        "instances": 16,
        "vcpu": 4,
        "avgLatencyMs": 3,
        "p95LatencyMs": 9,
        "autoscaling": true,
        "minInstances": 8,
        "maxInstances": 64
      }
    },
    {
      "id": "meta",
